# Copie ce fichier en .env.local et remplis les valeurs au fur et à mesure
# que tu crées chaque compte. Toutes ces variables sont optionnelles : le
# site fonctionne sans elles, chaque intégration s'active seule dès que sa
# clé est renseignée. Voir le README pour le détail de chaque service.

# --- Paiement (Stripe) ---
# https://dashboard.stripe.com/apikeys — utilise les clés "Test" pour essayer
# sans vrai argent, puis les clés "Live" une fois prêt à encaisser pour de vrai.
STRIPE_SECRET_KEY=

# URL publique du site, utilisée pour les redirections après paiement.
# En local, laisse tel quel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emailing (Brevo, anciennement Sendinblue) ---
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optionnel : ID de la liste de contacts Brevo à laquelle rattacher les
# inscrits (https://app.brevo.com/contact/list). Sans ça, ils sont ajoutés
# aux contacts génériques.
BREVO_LIST_ID=

# --- Mesure d'audience (Google Analytics 4) ---
# https://analytics.google.com — ID au format G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Google Search Console (vérification de propriété) ---
# https://search.google.com/search-console — méthode "balise HTML",
# copie juste le contenu de l'attribut "content" (pas toute la balise).
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Publicité (pixels de reciblage) ---
# Meta (Facebook/Instagram) : https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok : https://ads.tiktok.com/i18n/events_manager
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Analyse comportementale (Microsoft Clarity, gratuit) ---
# https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# --- Chat en direct (Crisp) ---
# https://app.crisp.chat/settings/website/ (Website ID)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# --- Avis clients (Trustpilot) ---
# N'affichera de vrais avis qu'une fois le compte créé ET les premières
# commandes livrées. https://businessapp.b2b.trustpilot.com
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID=
